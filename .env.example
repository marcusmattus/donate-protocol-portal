# Donate Protocol Environment Configuration

# Next.js
NODE_ENV=development

# Solana
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Alternative: https://devnet.helius-rpc.com/?api-key=your-key

# Wallet Configuration
NEXT_PUBLIC_WALLET_ADAPTERS=phantom,solflare

# Webhook authentication, shared by every TradingView webhook route.
# Comma-separated tokens in TRADINGVIEW_ALERT_TOKENS (below) take precedence;
# WEBHOOK_SECRET is the older single-token form and still works.
# With neither set, production rejects every webhook request (503) and only
# non-production falls back to the demo123/demo456 devnet tokens.
WEBHOOK_SECRET=demo-secret-key

# ── Privy login ─────────────────────────────────────────────────────────────
# Donate Protocol never sees a Privy password — users authenticate with Privy
# directly. The app id is public and must be NEXT_PUBLIC_; the app secret is a
# server credential for Privy's management API and is NOT needed to verify a
# login (that happens against Privy's public JWKS).
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional, only if your Privy app is configured with a client id.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Signs the httpOnly session cookie minted after a Privy token verifies.
# 16+ characters, and NOT the value below — generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# There is deliberately no in-repo fallback: a signing key that ships in the
# repo means anyone can forge a session, so with this unset login returns 503
# rather than issuing cookies nobody should trust.
SESSION_SECRET=

# ── TradingView official MCP integration ────────────────────────────────────
# Donate Protocol authorizes via TradingView's OAuth 2.1 flow (authorization
# code + PKCE). It never asks for, collects or stores a TradingView password.
TRADINGVIEW_MCP_URL=https://mcp.tradingview.com/mcp
TRADINGVIEW_OAUTH_CLIENT_ID=
# Only for confidential clients; public clients use PKCE alone.
TRADINGVIEW_OAUTH_CLIENT_SECRET=
TRADINGVIEW_OAUTH_REDIRECT_URI=http://localhost:3000/api/tradingview/oauth/callback
# Optional: pin the endpoints instead of relying on discovery.
TRADINGVIEW_OAUTH_AUTHORIZE_URL=
TRADINGVIEW_OAUTH_TOKEN_URL=
TRADINGVIEW_OAUTH_REVOKE_URL=

# Refuse to call any capability not yet reconciled against a live tools/list.
# Turn this on in production after running `npm run tv:reconcile`.
TRADINGVIEW_REQUIRE_VERIFIED_TOOLS=false

# ~100 tool requests per minute per user is the documented service limit.
TRADINGVIEW_RATE_CAPACITY=100
TRADINGVIEW_CACHE_MAX_ENTRIES=2000

# Symbol normalization defaults when an alert omits the exchange.
TRADINGVIEW_DEFAULT_CRYPTO_EXCHANGE=BINANCE
TRADINGVIEW_DEFAULT_STOCK_EXCHANGE=NASDAQ

# Comma-separated webhook tokens. Required in production for every webhook
# route; without it (and without WEBHOOK_SECRET) they all refuse requests.
TRADINGVIEW_ALERT_TOKENS=
# Optional HMAC secret. When set, alerts must carry a matching x-signature.
TRADINGVIEW_ALERT_SIGNING_SECRET=

AUDIT_LEDGER_MAX=10000

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id

# Jupiter Aggregator
JUPITER_API_URL=https://quote-api.jup.ag/v6

# ─── Database ───────────────────────────────────────────────────────────
# Postgres, for the tables in prisma/schema.prisma. Today that is one table:
# exchange_connections.
#
# Optional, and the two states are deliberately different:
#
#   unset  — exchange connections live in memory. The app runs with no
#            database at all, and connections do not survive a restart.
#   set    — the table *is* the store. If it cannot be reached, or the Prisma
#            client was never generated, requests fail loudly; they never fall
#            back to memory, because that would look like a user's connections
#            vanishing while new ones were written somewhere temporary.
#
# After setting it, create the table:  pnpm db:migrate
DATABASE_URL=postgresql://user:password@localhost:5432/donate_protocol
REDIS_URL=redis://localhost:6379

# API Configuration
API_PORT=3000
API_HOST=localhost

# Feature Flags
ENABLE_REAL_TRANSACTIONS=false
ENABLE_TELEGRAM_BOT=false
ENABLE_SOLANA_DEVNET=true

# Analytics
VERCEL_ANALYTICS_ID=

# ─── Exchange credential sealing ────────────────────────────────────────
# Required to store exchange API credentials. 32+ characters, random.
# There is deliberately NO fallback: with this unset, POST /api/exchanges
# returns 503 and stores nothing, rather than encrypting under a key that
# ships in the repo. Rotating it makes existing sealed records unopenable,
# so rotate by having users reconnect.
EXCHANGE_ENCRYPTION_KEY=

# Set to "off" to disable outbound credential-validation probes entirely, for
# deployments that permit no egress. Default is on.
EXCHANGE_VALIDATION=on
# Milliseconds between re-validation attempts on one connection (default 20000).
EXCHANGE_VALIDATION_COOLDOWN_MS=20000
# Active connections one user may hold (default 20).
EXCHANGE_MAX_PER_USER=20
